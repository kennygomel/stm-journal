{
  "name": "stm_journal_bot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "vite": "^7.1.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx tgcloud push",
    "push": "npx tgcloud push",
    "status": "npx tgcloud status",
    "migrate": "npx tgcloud migrate",
    "run": "npx tgcloud run",
    "test": "node --import ./tests/register-sdk.mjs tests/run.mjs",
    "test:ui": "npm run build && node tests/ui-smoke.mjs",
    "test:overflow": "npm run build && node tests/overflow.mjs"
  }
}
